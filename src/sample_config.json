{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        }
    },
    "handlers": {
        "stdout": {
            "class": "logging.StreamHandler",
            "level": "INFO",
            "formatter": "simple",
            "stream": "ext://sys.stdout"
        },
        "mlflow": {
            "class": "atlogger.MlflowHandler",
            "level": "DEBUG",
            "project": "example",
            "address": "mlflow.com"
        },
        "wandb": {
            "class": "atlogger.WandbHandler",
            "level": "DEBUG",
            "project": "example",
            "address": "wandb.com"
        },
        "file": {
            "class": "logging.FileHandler",
            "formatter": "simple",
            "filename": "app.log",
            "mode": "w"
        }
    },
    "root": {
        "level": "DEBUG",
        "handlers": [
            "stdout",
            "mlflow",
            "wandb",
            "file"
        ]
    }
}